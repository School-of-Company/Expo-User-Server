# Local development only
DB_URL=jdbc:postgresql://localhost:15433/expo_user
DB_USERNAME=expo_user
DB_PASSWORD=expo-user-local-only
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=16380
EUREKA_CLIENT_ENABLED=false
# PKCS#8 PEM RSA private key for signing access tokens (the matching public key lives in the gateway).
# Generate one locally: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# Paste it as a single line with \n for the line breaks. Never commit a real key.
JWT_PRIVATE_KEY=
# Shared secret for service-to-service calls (X-Internal-Token), at least 32 characters.
# Generate one locally: openssl rand -base64 32. Never commit a real value.
INTERNAL_TOKEN=
# Kafka broker for the survey answer events (local compose default)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
# Token sent to the Expo service (X-Internal-Token); must equal Expo's EXPO_INTERNAL_TOKEN, at least 32 characters.
EXPO_INTERNAL_TOKEN=
# Optional: call Expo directly (local development without Eureka), e.g. http://localhost:8081
EXPO_URL=
# Optional: bootstrap the first admin on an empty DB. At startup, if no approved admin exists and a pending account with
# this nickname exists, that account is approved as an admin (not at sign-up). No password goes here. Pick a nickname that
# is hard to guess, sign up with it yourself, restart, then empty this value. See README for the procedure.
BOOTSTRAP_ADMIN_NICKNAME=
# Optional: call Notification directly for the participant phone OTP (local development without Eureka), e.g. http://localhost:3000
NOTIFICATION_URL=
# Optional: token sent to Notification POST /sms (X-Internal-Token) so participant OTPs use the internal hourly cap instead of
# the public one. Must equal Notification's sms.authInternalToken (SMS_AUTH_INTERNAL_TOKEN), at least 32 characters. Empty = not sent.
NOTIFICATION_INTERNAL_TOKEN=
# Optional: how many devices one admin can stay signed in on at once (each sign-in adds a refresh token; the oldest is dropped past this). Default 10.
JWT_MAX_REFRESH_TOKENS=10
# Admin sign-in brute-force limit: this many failed attempts per nickname within the lock duration blocks sign-in (429) until it ends.
SIGNIN_MAX_FAILURES=5
SIGNIN_LOCK_DURATION=15m
# Participant (non-admin) phone-verification session. The session id is an opaque HttpOnly cookie; the verified phone stays in Redis.
# PARTICIPANT_SESSION_TTL is the application session lifetime; the OTP lifetime itself is managed by Notification.
# PARTICIPANT_OTP_USED_TTL should be at least Notification's OTP lifetime so a used code cannot mint another session.
# PARTICIPANT_SESSION_COOKIE_SECURE=false only for local HTTP development.
PARTICIPANT_SESSION_TTL=30m
PARTICIPANT_OTP_USED_TTL=10m
PARTICIPANT_SESSION_COOKIE_NAME=PARTICIPANT_SESSION
PARTICIPANT_SESSION_COOKIE_SECURE=true
PARTICIPANT_SESSION_COOKIE_SAME_SITE=Lax
PARTICIPANT_SESSION_COOKIE_DOMAIN=
# Optional: HMAC key for storing verified phone numbers (admin verification counts) as hashes, never in plain text.
# Empty = derived from INTERNAL_TOKEN. Changing this (or INTERNAL_TOKEN) makes already stored numbers count once more.
PARTICIPANT_PHONE_HASH_KEY=
# API docs (springdoc). Off by default. true serves /auth/v3/api-docs and /auth/swagger-ui.html (under the /auth Gateway prefix so the
# Gateway docs page can find it). Leave false on servers unless you need the docs.
SWAGGER_ENABLED=false
# true includes the /internal APIs and the X-Internal-Token scheme in the docs (default false). No effect unless SWAGGER_ENABLED=true
SWAGGER_INCLUDE_INTERNAL=false
# One access log line per HTTP request (module HttpAccess, e.g. "PATCH /admin/{admin_id} status: 200 (12ms)"). Default true; false turns it off.
LOGGING_HTTP_ACCESS_ENABLED=true
# Local projection of Expo's expo.expo.changed events (consumer group expo-user-server.expo-changed, DLT expo.expo.changed.dlt).
# Default false keeps calling Expo synchronously. true starts the consumer and reads expo periods/preregister sessions from the
# projection, falling back to the Expo call for expos not projected yet. After turning it on, ask Expo to republish once.
KAFKA_EXPO_PROJECTION_ENABLED=false
